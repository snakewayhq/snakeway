interface types {
  record header {
    name: string,
    value: string,
  }

  variant header-op {
    set(header),
    append(header),
    remove(string),
  }

  record request {
    method: string,
    scheme: string,
    authority: string,
    original-path: string,
    route-path: string,
    query: string,
    client-ip: string,
    headers: list<header>,
  }

  record response {
    status: u16,
    headers: list<header>,
  }

  record body-chunk {
    data: list<u8>,
    end-of-stream: bool,
  }

  record synthetic-response {
    status: u16,
    headers: list<header>,
    body: list<u8>,
  }

  variant action {
    %continue,
    block,
    respond(synthetic-response),
  }

  record request-patch {
    set-route-path: option<string>,
    set-upstream-path: option<string>,
    ops: list<header-op>,
  }

  record response-patch {
    set-status: option<u16>,
    ops: list<header-op>,
  }

  record request-result {
    action: action,
    patch: option<request-patch>,
  }

  record response-result {
    action: action,
    patch: option<response-patch>,
  }

  variant body-action {
    passthrough,
    replace(list<u8>),
    %drop,
    block,
  }

  record body-result {
    action: body-action,
  }
}

interface host {
  config-get: func(key: string) -> option<string>;

  log: func(level: u8, message: string);

  metric-increment: func(name: string, delta: u64);

  epoch-secs: func() -> u64;
}
